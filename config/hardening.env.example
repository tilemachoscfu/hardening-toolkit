# Copy to hardening.env, replace every CHANGE_ME value, and keep it private.
LAN_IF=CHANGE_ME
LAN_V4=CHANGE_ME
VPN_IF=tailscale0
VPN_V4=100.64.0.0/10
VPN_V6=fd7a:115c:a1e0::/48
VPN_UDP_PORT=41641

BACKUP_ROOT=/root/hardening-backups
ROLLBACK_SECONDS=180

# Optional AdGuard Home integration.
ADGUARD_CONTAINER=adguard-home
ADGUARD_CONFIG=CHANGE_ME
DNS_HEALTHCHECK_SERVER=CHANGE_ME
DNS_HEALTHCHECK_NAME=dns.quad9.net

